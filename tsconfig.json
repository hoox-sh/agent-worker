{
	"compilerOptions": {
		"target": "es2022",
		"module": "es2022",
		"lib": ["es2022"],
		"types": ["@cloudflare/workers-types", "bun-types"],
		"moduleResolution": "bundler",
		"strict": true,
		"skipLibCheck": true,
		"resolveJsonModule": true
	},
	"include": ["src", "tests"],
	"exclude": ["test", "node_modules"]
}
