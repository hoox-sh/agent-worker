{
  "display_name": "Agent Worker",
  "description": "AI risk manager and autonomous agent with multi-provider AI (Workers AI, OpenAI, Anthropic, Google, Azure)",
  "sections": {
    "cron": {
      "title": "Schedule",
      "description": "Cron and automation settings",
      "icon": "clock",
      "priority": 20,
      "fields": {
        "enabled": true,
        "interval_minutes": 5,
        "housekeeping_enabled": true
      }
    },
    "behavior": {
      "title": "Behavior",
      "description": "Autonomous behavior and risk management settings",
      "icon": "activity",
      "priority": 30,
      "fields": {
        "auto_trailing_stop": true,
        "auto_rebalance": false,
        "risk_override_enabled": true,
        "max_daily_drawdown_percent": -5,
        "trailing_stop_percent": 0.05,
        "take_profit_percent": 0.10
      }
    },
    "ai_providers": {
      "title": "AI Providers",
      "description": "Configure multi-provider AI gateway with fallback chain, timeouts, and retries.",
      "icon": "brain",
      "priority": 10,
      "fields": {
        "default_provider": "workers-ai",
        "fallback_chain": ["workers-ai", "openai", "anthropic", "google", "azure"],
        "timeout_ms": 30000,
        "retry_count": 3,
        "model_map": {
          "workers-ai": "@cf/meta/llama-3.1-8b-instruct",
          "openai": "gpt-4o-mini-2024-07-18",
          "anthropic": "claude-3-haiku-20240307",
          "google": "gemini-1.5-flash-002",
          "azure": "gpt-4o-mini"
        }
      },
      "descriptions": {
        "default_provider": "Primary AI provider used for all requests.",
        "fallback_chain": "Ordered list of providers to try on failure (automatic fallback).",
        "timeout_ms": "Per-request timeout in milliseconds before failing over.",
        "retry_count": "Number of retry attempts per provider before moving to next in chain.",
        "model_map": "Default model to use for each provider."
      }
    },
    "secrets": {
      "title": "API Keys & Secrets",
      "description": "Provider API keys and endpoints. Use CLI to update secrets securely.",
      "icon": "key",
      "priority": 15,
      "fields": {
        "openai_key": "Requires CLI Setup",
        "anthropic_key": "Requires CLI Setup",
        "google_key": "Requires CLI Setup",
        "azure_api_key": "Requires CLI Setup",
        "azure_endpoint": "Requires CLI Setup"
      },
      "descriptions": {
        "openai_key": "OpenAI API Key (Secret). DO NOT save plaintext. Run: hoox secrets update-cf agent-worker openai_key",
        "anthropic_key": "Anthropic API Key (Secret). DO NOT save plaintext. Run: hoox secrets update-cf agent-worker anthropic_key",
        "google_key": "Google Gemini API Key (Secret). DO NOT save plaintext. Run: hoox secrets update-cf agent-worker google_key",
        "azure_api_key": "Azure OpenAI API Key (Secret). DO NOT save plaintext. Run: hoox secrets update-cf agent-worker azure_api_key",
        "azure_endpoint": "Azure OpenAI Endpoint URL. Run: hoox secrets update-cf agent-worker azure_endpoint"
      }
    },
    "features": {
      "title": "AI Features",
      "description": "Enable/disable specific AI capabilities (vision, reasoning, streaming, etc.).",
      "icon": "sparkle",
      "priority": 25,
      "fields": {
        "chat_streaming_enabled": true,
        "vision_enabled": true,
        "reasoning_enabled": true,
        "embedding_enabled": true,
        "usage_tracking_enabled": true,
        "prompt_templates_enabled": true
      },
      "descriptions": {
        "chat_streaming_enabled": "Enable SSE streaming for chat responses (real-time tokens).",
        "vision_enabled": "Enable vision/image analysis endpoint (POST /agent/vision).",
        "reasoning_enabled": "Enable extended thinking/reasoning models (POST /agent/reasoning).",
        "embedding_enabled": "Enable text embedding generation (POST /agent/embedding).",
        "usage_tracking_enabled": "Track API usage across all providers (GET /agent/usage).",
        "prompt_templates_enabled": "Enable built-in prompt templates (GET /agent/prompts)."
      }
    },
    "defaults": {
      "title": "Model Defaults",
      "description": "Default parameters for AI requests.",
      "icon": "sliders",
      "priority": 35,
      "fields": {
        "default_temperature": 0.7,
        "default_max_tokens": 1024,
        "system_prompt_chat": "You are a professional crypto trading analyst.",
        "system_prompt_reasoning": "You are a senior risk management strategist.",
        "system_prompt_vision": "You are a professional technical analyst."
      },
      "descriptions": {
        "default_temperature": "Default sampling temperature for chat/reasoning requests.",
        "default_max_tokens": "Default maximum tokens per response.",
        "system_prompt_chat": "System prompt used for general chat requests.",
        "system_prompt_reasoning": "System prompt used for reasoning/extended-thinking requests.",
        "system_prompt_vision": "System prompt used for vision/image analysis requests."
      }
    },
    "analytics": {
      "title": "Analytics",
      "description": "Analytics and metrics collection via analytics-worker",
      "icon": "bar-chart",
      "priority": 45,
      "fields": {
        "analytics_enabled": true,
        "track_ai_usage": true,
        "track_api_latency": true,
        "track_errors": true
      },
      "descriptions": {
        "analytics_enabled": "Send event data to analytics-worker for dashboard visualization.",
        "track_ai_usage": "Track AI provider token usage, latency, and costs per request.",
        "track_api_latency": "Track inter-worker API call latency and success rates.",
        "track_errors": "Track error rates and types for monitoring and alerting."
      }
    },
    "endpoints": {
      "title": "Available Endpoints",
      "description": "All REST endpoints exposed by the agent-worker.",
      "icon": "globe",
      "priority": 50,
      "fields": {
        "GET /agent/config": "Get current AI provider configuration",
        "POST /agent/config": "Update AI provider configuration at runtime",
        "GET /agent/models": "List all available AI models",
        "POST /agent/test-model": "Test a specific AI model",
        "GET /agent/health": "Check health status of all AI providers",
        "POST /agent/chat": "AI chat with SSE streaming support",
        "POST /agent/vision": "Vision analysis (image URL or base64)",
        "POST /agent/reasoning": "Extended thinking with reasoning models",
        "GET /agent/usage": "AI API usage statistics",
        "GET /agent/prompts": "List available prompt templates",
        "POST /agent/embedding": "Generate text embeddings",
        "POST /agent/risk-override": "Manually enforce or release risk locks",
        "GET /agent/status": "Real-time health and active trailing stops"
      }
    }
  }
}