{
  // Agent Worker — AI risk manager (configurable cron: 1–1440 minutes)
  // Set triggers.crons to match the desired interval (see README "Cron setup"):
  //   1 min → "* * * * *" | 15 min → "*/15 * * * *" | 60 min → "0 * * * *" | 1440 → "0 0 * * *"
  // Empty "crons": [] disables scheduled runs (manual POST /agent/housekeeping still works).
  "name": "agent-worker",
  "account_id": "YOUR_ACCOUNT_ID",
  "main": "src/index.ts",
    "alias": {
    "@hoox-sh/hoox-shared/errors": "../../packages/shared/src/errors.ts",
    "@hoox-sh/hoox-shared/middleware": "../../packages/shared/src/middleware/index.ts",
    "@hoox-sh/hoox-shared/router": "../../packages/shared/src/router.ts",
    "@hoox-sh/hoox-shared/health": "../../packages/shared/src/health.ts",
    "@hoox-sh/hoox-shared/kvKeys": "../../packages/shared/src/kvKeys.ts",
    "@hoox-sh/hoox-shared/analytics": "../../packages/shared/src/analytics.ts",
    "@hoox-sh/hoox-shared/cron-handler": "../../packages/shared/src/cron-handler.ts",
    "@hoox-sh/hoox-shared/service-bindings": "../../packages/shared/src/service-bindings.ts"
  },
  "compatibility_date": "2026-06-08",
  "compatibility_flags": ["nodejs_compat"],
  "placement": {
    "mode": "smart"
  },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 }
  },
  "triggers": {
    // Default: every 15 minutes (align with dashboard.jsonc cron.interval_minutes)
    "crons": ["*/15 * * * *"]
  },
  "services": [
    {
      "binding": "D1_SERVICE",
      "service": "d1-worker"
    },
    {
      "binding": "TRADE_SERVICE",
      "service": "trade-worker"
    },
    {
      "binding": "TELEGRAM_SERVICE",
      "service": "telegram-worker"
    },
    {
      "binding": "ANALYTICS_SERVICE",
      "service": "analytics-worker"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "CONFIG_KV",
      "id": "YOUR_CONFIG_KV_ID"
    }
  ],
  "vars": {},
  "ai": {
    "binding": "AI"
  }
  // Secrets are set via wrangler / hoox CLI (never via dashboard CONFIG_KV for API keys):
  //   wrangler secret put OPENAI_API_KEY
  //   wrangler secret put ANTHROPIC_API_KEY
  //   wrangler secret put GOOGLE_API_KEY
  //   wrangler secret put AZURE_API_KEY
  //   wrangler secret put AZURE_ENDPOINT
  //   wrangler secret put AGENT_INTERNAL_KEY
  // or: hoox secrets set agent-worker OPENAI_API_KEY
  //
  // Provider key resolution order (per provider):
  //   1. env secret binding (above) — preferred, not readable via dashboard KV
  //   2. CONFIG_KV fallback (agent:openai_key, agent:anthropic_key, agent:google_key,
  //      agent:azure_api_key, agent:azure_endpoint) — backward compatible; warns once
}
