{
  "name": "agent-worker",
  // ACCOUNT_ID: Get from Cloudflare Dashboard > Overview > Account ID
  "account_id": "YOUR_ACCOUNT_ID",
  "main": "src/index.ts",
  "compatibility_date": "2026-04-17",
  "compatibility_flags": ["nodejs_compat"],

  // PLACEMENT: Smart Placement for reduced latency (free, all plans)
  "placement": {
    "mode": "smart"
  },

  // OBSERVABILITY: Enable logging and sampling
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },

  // TRIGGERS: Cron schedule for autonomous monitoring
  // Runs every 5 minutes for portfolio analysis
  "triggers": {
    "crons": ["*/5 * * * *"]
  },

  // SERVICES: Service bindings to other workers
  "services": [
    {
      "binding": "D1_SERVICE",
      "service": "d1-worker"
    },
    {
      "binding": "TRADE_SERVICE",
      "service": "trade-worker"
    },
    {
      "binding": "TELEGRAM_SERVICE",
      "service": "telegram-worker"
    },
    {
      "binding": "ANALYTICS_SERVICE",
      "service": "analytics-worker"
    }
  ],

  // KV_NAMESPACES: Key-Value storage for config and kill switch
  "kv_namespaces": [
    {
      "binding": "CONFIG_KV",
      "id": "YOUR_CONFIG_KV_ID"
    }
  ],

  // AI: Cloudflare Workers AI for risk analysis and summaries
  // Note: AGENT_INTERNAL_KEY is set via `wrangler secret put`
  "ai": {
    "binding": "AI"
  }
}